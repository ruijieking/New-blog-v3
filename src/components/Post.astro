---
// 博客文章列表组件：读取文章、按日期排序、渲染卡片列表
import { getCollection } from 'astro:content';
import AnimateIn from './AnimateIn.astro';
import ReadFrostedGlass from './ReadFrostedGlass.astro';
import Icon from './Icon.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.localeCompare(a.data.pubDate),
);
---

<div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
  <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">BLOG / 文章</p>
  <h1 class="text-3xl font-bold mb-8">文章列表</h1>

  {posts.length === 0 ? (
    <p class="text-fg/50">还没有文章。</p>
  ) : (
    <div class="flex flex-col gap-4">
      {posts.map((post, i) => {
        const { title, description, pubDate, category, tags, cover, coverAlt } = post.data;
        const href = `/blog/${post.id}`;
        return (
          <AnimateIn delay={i * 80}>
            <a href={href} class="block group transition-all duration-300
                                  hover:-translate-y-0.5">
              <ReadFrostedGlass>
                <!-- 用 items-stretch 让缩略图撑满卡片高度；负 margin 抵消卡片内边距，做到贴边 -->
                <div class="flex items-stretch gap-4 sm:gap-6">
                  <!-- 左：封面缩略图（可选，没写 cover 就自动省略）
                       图片用 absolute 定位，不参与高度计算，卡片高度只由文字决定 -->
                  {cover && (
                    <div class="relative shrink-0 overflow-hidden rounded-l-[15px]
                                -my-8 -ml-8 md:-my-10 md:-ml-10
                                w-24 sm:w-40">
                      <img
                        src={cover}
                        alt={coverAlt || title}
                        loading="lazy"
                        class="absolute inset-0 w-full h-full object-cover
                               transition-transform duration-500 group-hover:scale-[1.06]"
                      />
                    </div>
                  )}

                  <!-- 中：标题 + 描述 + 元信息 -->
                  <div class="min-w-0 flex-1 self-center">
                    <!-- 标题 -->
                    <h2 class="text-lg font-bold text-fg group-hover:text-accent
                               transition-colors duration-200 leading-snug">
                      {title}
                    </h2>

                    <!-- 描述 / 副标题 -->
                    <p class="mt-2 text-sm text-fg/50 leading-relaxed line-clamp-2">
                      {description}
                    </p>

                    <!-- 底部：日期 + 标签 + 分类 -->
                    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                      <!-- 日期 -->
                      <time datetime={pubDate} class="text-xs text-fg/35 font-mono">
                        {pubDate}
                      </time>

                      <!-- 标签 -->
                      {tags && tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5">
                        {tags.map((tag) => (
                          <span class="text-xs text-fg/40 hover:text-accent transition-colors">
                            #{tag}
                          </span>
                        ))}
                      </div>
                      )}

                      <!-- 分类标签（右侧） -->
                      {category && (
                      <span class="ml-auto text-xs font-medium tracking-wide uppercase
                                   text-accent bg-accent/10 px-2.5 py-1 rounded-full">
                        {category}
                      </span>
                      )}
                    </div>
                  </div>

                  <!-- 右：进入箭头（悬停时变主题色并向右移一点） -->
                  <Icon
                    name="arrow-right"
                    class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 self-center text-fg/25
                           transition-all duration-300
                           group-hover:text-accent group-hover:translate-x-0.5"
                  />
                </div>
              </ReadFrostedGlass>
            </a>
          </AnimateIn>
        );
      })}
    </div>
  )}
</div>
