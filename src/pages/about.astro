---
// 关于我页面：上下两张卡片 —— 上方「头像 + 社交链接」，下方简介
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimateIn from '../components/AnimateIn.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';

// 优先用 site.author.avatar，留空则回退到 GitHub 头像
const avatar = site.author.avatar || `https://github.com/${site.author.github}.png`;
const socials = site.socials ?? [];
---

<BaseLayout title="关于我">
  <div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">ABOUT / 关于我</p>
    <h1 class="text-3xl font-bold mb-8">关于我</h1>

    <div class="space-y-6">
      <!-- 上方卡片：左侧头像，右侧姓名与社交链接 -->
      <AnimateIn>
        <div
          class="rounded-2xl border border-fg/10 bg-bg/50 backdrop-blur-md
                 shadow-lg shadow-black/5 p-6 sm:p-8
                 flex items-center gap-6"
        >
          <!-- 左：头像，靠卡片左边缘 -->
          <img
            src={avatar}
            alt={`${site.author.name} 的头像`}
            width="112"
            height="112"
            loading="lazy"
            class="w-24 h-24 sm:w-28 sm:h-28 shrink-0 rounded-full object-cover
                   ring-2 ring-fg/10 shadow-md"
          />

          <!-- 右：姓名 + 社交链接（自左向右排列） -->
          <div class="min-w-0 flex-1">
            <p class="text-lg font-bold truncate">{site.author.name}</p>

            {socials.length > 0 && (
              <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                {socials.map((s) => (
                  <li>
                    <a
                      href={s.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm text-fg/60
                             hover:text-accent transition-colors duration-200"
                    >
                      <Icon name={s.icon} class="w-4 h-4 shrink-0" />
                      <span>{s.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </AnimateIn>

      <!-- 下方卡片：简介 -->
      <AnimateIn delay={100}>
        <div
          class="rounded-2xl border border-fg/10 bg-bg/50 backdrop-blur-md
                 shadow-lg shadow-black/5 p-6 sm:p-8"
        >
          <h2 class="text-xs font-mono tracking-[0.3em] uppercase text-fg/40 mb-4">简介</h2>
          <p class="text-fg/70 leading-relaxed">{site.about}</p>
        </div>
      </AnimateIn>
    </div>
  </div>
</BaseLayout>
